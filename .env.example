# Copy file này thành .env và điền giá trị thật
ANTHROPIC_API_KEY=sk-ant-...

# LLM provider: claude | (gemini, deepseek sẽ thêm sau)
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5-20251001

# Storage adapter: sqlite | (csv, power_automate, m365_graph sẽ thêm sau)
STORAGE_ADAPTER=sqlite
SQLITE_PATH=data/dealers.db

# Server
HOST=127.0.0.1
PORT=8000
