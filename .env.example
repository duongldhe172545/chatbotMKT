# Copy file nay thanh .env va dien gia tri that. KHONG commit .env.

# ============================================================
# LLM (Gemini only)
# ============================================================
GEMINI_API_KEY=your-gemini-api-key-here
LLM_FAST=gemini-3.1-flash-lite
LLM_QUALITY=gemini-3.1-flash-lite
CONVERSATION_ENGINE=llm_first
# Supported: legacy, planner_shadow, planner, llm_first

# ============================================================
# LOGO GENERATION
# ============================================================
LOGO_GENERATION_MODE=local
# Supported: local, hybrid
# hybrid calls Imagen and may incur API charges
LOGO_IMAGE_MODEL=imagen-4.0-ultra-generate-001
LOGO_GENERATION_ASYNC=true
LOGO_OUTPUT_RETENTION_DAYS=7

# ============================================================
# STORAGE
# ============================================================
SQLITE_PATH=data/chatbot.db

# ============================================================
# SERVER
# ============================================================
HOST=127.0.0.1
PORT=8000

# ============================================================
# ADMIN AUTH (HTTP Basic - /admin + /api/admin/*)
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ============================================================
# CORS
# ============================================================
CORS_ALLOWED_ORIGINS=*

# ============================================================
# SESSION / RATE LIMIT
# ============================================================
SESSION_TIMEOUT_S=86313600
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_MSG_PER_MINUTE=30

# ============================================================
# BACKGROUND SCHEDULER
# ============================================================
SCHEDULER_ENABLED=true
SCHEDULER_SWEEP_INTERVAL_S=300
SESSION_TIMEOUT_NUDGE_CARD_S=180
SESSION_TIMEOUT_CONFIRMING_S=600
