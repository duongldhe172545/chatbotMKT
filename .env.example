# Copy file này thành .env và điền giá trị thật
ANTHROPIC_API_KEY=sk-ant-...

# LLM provider: claude | (gemini, deepseek sẽ thêm sau)
LLM_PROVIDER=claude
# Tách 2 model cho Extractor (trích field) vs Replier (sinh reply):
# - Extractor: structured extraction — Haiku đủ chất lượng + nhanh 3x + rẻ 3x
# - Replier: persona reply — Sonnet để giữ chất lượng
EXTRACTOR_MODEL=claude-haiku-4-5-20251001
REPLIER_MODEL=claude-sonnet-4-6
# Backward compat — fallback nếu 2 biến trên không set:
# LLM_MODEL=claude-sonnet-4-6

# Storage adapter: sqlite | (csv, power_automate, m365_graph sẽ thêm sau)
STORAGE_ADAPTER=sqlite
SQLITE_PATH=data/dealers.db

# Server
HOST=127.0.0.1
PORT=8000

# Refactor flags
# Bật Replier (tách reply khỏi Extractor). false = giữ nguyên flow cũ.
USE_REPLIER=false

# Admin auth (cho /admin + /api/admin/*) — đặt password mạnh ở production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# CORS — danh sách origin được phép gọi API (CSV). Default "*" cho dev.
# Production NÊN whitelist: CORS_ALLOWED_ORIGINS=https://chat.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
