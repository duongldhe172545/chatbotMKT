# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env.
# Refer STRATEGY D8 — spec model-agnostic, 2-tier LLM tier abstraction.

# ============================================================
# LLM VENDOR (pilot Gemini, fallback Claude)
# ============================================================
# Primary vendor — Gemini cho pilot (rẻ ~10x Claude)
GEMINI_API_KEY=your-gemini-api-key-here

# Fallback vendor — Claude (dùng khi Gemini fail / cần reasoning tốt hơn)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================================
# LLM TIER MAPPING (refer STRATEGY D8 + GLOSSARY § 5)
# ============================================================
# LLM_FAST: intent classify, extractor, STT brand correct, address parser,
#           auto-derive brand_short/initials, ack Bận/Lửa Lò
LLM_FAST=gemini-2.5-flash
# LLM_FAST_FALLBACK=claude-haiku-4-5-20251001

# LLM_QUALITY: ack Khoe/Lo (insight cụ thể), slogan options (5 phương án sáng tạo),
#              defensive/tâm sự handler (F2B.4b)
LLM_QUALITY=gemini-2.5-pro
# LLM_QUALITY_FALLBACK=claude-sonnet-4-6

# ============================================================
# STORAGE
# ============================================================
# SQLite cho pilot (refer STRATEGY phụ lục "Vì sao SQLite không Postgres")
SQLITE_PATH=data/chatbot.db

# ============================================================
# SERVER
# ============================================================
HOST=127.0.0.1
PORT=8000

# ============================================================
# ADMIN AUTH (HTTP Basic — /admin + /api/admin/*)
# ============================================================
# Production đặt password MẠNH
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ============================================================
# CORS — origin được phép gọi API (CSV)
# ============================================================
# Production whitelist: CORS_ALLOWED_ORIGINS=https://chat.example.com
CORS_ALLOWED_ORIGINS=*

# ============================================================
# SESSION / RATE LIMIT (refer 2C F2C.1, F2C.2)
# ============================================================
SESSION_TIMEOUT_S=3600
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_MSG_PER_MINUTE=30
