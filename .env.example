# Copy file nay thanh .env va dien gia tri that. KHONG commit .env.
# Moi bien duoi day deu duoc doc boi app/core/config_v2.py (Settings.from_env).

# ============================================================
# MOI TRUONG
# ============================================================
APP_ENV=local
# Supported: local, production (production bat buoc set SESSION_TOKEN_SECRET,
# ADMIN_API_TOKEN, ZALO_GROUP_URL khac default)
APP_BASE_URL=http://127.0.0.1:8000

# ============================================================
# LLM (Gemini only)
# ============================================================
GEMINI_API_KEY=your-gemini-api-key-here
LLM_FAST=gemini-3.1-flash-lite
LLM_QUALITY=gemini-3.1-flash-lite

# Chon engine sinh CAU TRA LOI (reply generation):
#   parlant_local | stub -> cau mau cung deterministic, KHONG goi LLM cho reply
#   gemini               -> goi Gemini sinh reply tu nhien (can GEMINI_API_KEY)
# Luu y: extraction (trich field/intent) LUON dung Gemini neu co API key,
# bat ke gia tri bien nay.
CONVERSATION_RUNTIME=gemini

# ============================================================
# LOGO GENERATION
# ============================================================
LOGO_PROVIDER=local
# Supported: local (SVG offline), imagen (goi AI Imagen — ton phi API)
LOGO_IMAGE_MODEL=imagen-4.0-ultra-generate-001

# ============================================================
# STORAGE
# ============================================================
# Cach 1: SQLITE_PATH (duong dan file — tu dong prepend sqlite:///)
SQLITE_PATH=data/chatbot_v2.sqlite3
# Cach 2: DATABASE_URL=sqlite:///./data/chatbot_v2.sqlite3 (uu tien hon SQLITE_PATH)
# Tren Railway: neu mount volume /data thi tu detect, khong can set.

# ============================================================
# SERVER
# ============================================================
HOST=127.0.0.1
PORT=8000

# ============================================================
# SECURITY
# ============================================================
SESSION_TOKEN_SECRET=local-dev-change-me
ADMIN_API_TOKEN=local-admin-token

# ============================================================
# ADMIN AUTH (HTTP Basic - /admin + /api/admin/*)
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# ============================================================
# CORS
# ============================================================
CORS_ALLOWED_ORIGINS=*

# ============================================================
# SESSION / RATE LIMIT
# ============================================================
SESSION_TIMEOUT_S=86313600
RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_MSG_PER_MINUTE=30

# ============================================================
# BACKGROUND SCHEDULER
# ============================================================
SCHEDULER_ENABLED=true
SCHEDULER_SWEEP_INTERVAL_S=300

# ============================================================
# FEATURE FLAGS
# ============================================================
FEATURE_VOICE_INPUT=true
FEATURE_LONG_POLL_EVENTS=true

# ============================================================
# ZALO
# ============================================================
ZALO_CTA_ENABLED=true
# ZALO_GROUP_URL=https://zalo.me/g/xxxxxx   # BAT BUOC khi APP_ENV=production

# ============================================================
# RULES VERSION
# ============================================================
ACTIVE_RULES_VERSION=v2.0
