# ============================================================
# SECRETS — KHÔNG BAO GIỜ COMMIT
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials.json
*-credentials.json
config.local.*

# ============================================================
# DỮ LIỆU DEALER (PII — chống commit nhầm)
# ============================================================
# Note: dùng data/* (1 level) thay vì data/ — để whitelist JSON seed
# (gitignore không re-include được nếu parent dir bị ignore).
# Inline # KHÔNG phải comment trong gitignore — phải để comment riêng line.
data/*
!data/.gitkeep
# Whitelist JSON seed (province_list, province_specialty, main_category_enum) — refer F2C.7
!data/*.json
*.db
*.db-wal
*.db-shm
*.db-journal

# Test / debug scripts tạm (không commit)
test_audit.py
test_live_chat.py
debug_session.py
check_db.py
test_output.txt

